# --- Юзер-бот для explore_bot.py ---
# Получить на https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_PHONE=+79991234567

# Целевой бот (username без @)
TG_TARGET=sticker_bot

# Параметры обхода
MAX_DEPTH=3
WAIT_TIMEOUT=4.0
OUTPUT_FILE=structure.json

# --- monitor_launches.py ---
# Уведомления в TG-канал. Получить токен у @BotFather, добавить бота админом
# в свой канал, в TG_CHAT_ID указать @username канала или числовой id (-100...)
TG_BOT_TOKEN=
TG_CHAT_ID=

POLL_INTERVAL=30
LIMIT=20
NOTIFY_BACKLOG=0          # 1 = разослать уведы по уже виденным при первом запуске
